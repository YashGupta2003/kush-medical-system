# ---- MySQL connection ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kush_medical

# ---- JWT Authentication (REQUIRED) ----
# SECURITY: You MUST set this to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# The server will refuse to start if this is left as the default.
JWT_SECRET_KEY=change-this-to-a-real-random-secret-before-deploying
JWT_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Google Cloud Vision OCR ----
# 1. Create a project in Google Cloud Console
# 2. Enable the "Cloud Vision API"
# 3. Create a Service Account, download its JSON key file
# 4. Put the path to that JSON file below
# IMPORTANT: gcp-vision-key.json MUST be in .gitignore — never commit it!
# If it was previously committed/exposed, revoke and regenerate the key at:
#   console.cloud.google.com → IAM → Service Accounts → Keys → Delete key
GOOGLE_APPLICATION_CREDENTIALS=./gcp-vision-key.json

# ---- Misc ----
UPLOAD_DIR=./uploads
FUZZY_MATCH_THRESHOLD=85
REDIS_URL=redis://localhost:6379/0

# ---- Rate Limiting (slowapi) ----
# Global default applied to every endpoint unless overridden below.
RATE_LIMIT_GLOBAL=100/minute
# AI endpoints (Copilot, Symptom Bot) — shared 10/minute default.
RATE_LIMIT_COPILOT=10/minute
# OCR upload (bills + prescriptions) — intentionally strict at 10/minute
# because each request triggers a paid Google Cloud Vision API call.
# Raise only if you have billing alerts set up and accept the cost.
RATE_LIMIT_OCR=10/minute
# Login endpoint — brute-force protection.
RATE_LIMIT_AUTH=5/minute
# Public registration / setup wizard endpoints.
RATE_LIMIT_SETUP=5/hour

# ---- PharmaCopilot (Pillar 2) ----
# Leave empty to use the deterministic fallback (no AI responses).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- WhatsApp Notifications (Priority 1) ----
# Leave all empty to disable WhatsApp delivery (in-app notifications still work).
# For Twilio sandbox testing: use whatsapp:+14155238886 as the number.
# For production: use your approved WhatsApp Business number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ---- Sentry Error Tracking (Priority 2e) ----
# Leave empty to disable. Get a DSN at sentry.io.
SENTRY_DSN=

# ---- Voice Assistant (Gemini API) ----
# Key comes from Google AI Studio (https://aistudio.google.com/apikey).
# It's free-tier with rate limits (not unlimited).
# The primary/fallback model split combines two separate free quotas for better resilience.
GEMINI_API_KEY=
