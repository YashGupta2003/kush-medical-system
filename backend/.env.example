# ---- Database connection ----
# The DB_* fields build the historical MySQL URL. For managed PostgreSQL
# (Render, Supabase, Neon, etc.) set DATABASE_URL instead — it takes
# precedence. Install psycopg2-binary when using PostgreSQL.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/pharmos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pharmos

# ---- JWT Authentication (REQUIRED) ----
# SECURITY: You MUST set this to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# The server will refuse to start if this is left as the default.
JWT_SECRET_KEY=change-this-to-a-real-random-secret-before-deploying
JWT_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Google Cloud Vision OCR ----
# 1. Create a project in Google Cloud Console
# 2. Enable the "Cloud Vision API"
# 3. Create a Service Account, download its JSON key file
# 4. Put the path to that JSON file below
# IMPORTANT: gcp-vision-key.json MUST be in .gitignore — never commit it!
# If it was previously committed/exposed, revoke and regenerate the key at:
#   console.cloud.google.com → IAM → Service Accounts → Keys → Delete key
GOOGLE_APPLICATION_CREDENTIALS=./gcp-vision-key.json

# ---- Misc ----
UPLOAD_DIR=./uploads
FUZZY_MATCH_THRESHOLD=85

# =====================================================================
# Redis / Celery runtime — choose ONE deployment mode
# =====================================================================
# REDIS_URL is the single source of truth. CELERY_BROKER_URL and
# CELERY_RESULT_BACKEND inherit it when left blank, but may be overridden.
# Use rediss:// for TLS brokers (Upstash, Render managed Redis, etc.).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
REDIS_SSL_CERT_REQS=none

# ---------------------------------------------------------------------
# MODE A — Zero-Redis free-tier deployment (recommended for a minor project)
# ---------------------------------------------------------------------
# No Redis service, no Celery worker, no Beat process. Tasks execute inline
# via FastAPI BackgroundTasks with a synchronous safety net. The app still
# starts and serves requests if a Redis URL is configured but unreachable.
# For Mode A, set CELERY_TASK_ALWAYS_EAGER=true below.
# CELERY_TASK_ALWAYS_EAGER=true

# ---------------------------------------------------------------------
# MODE B — Full production deployment (managed Redis + Celery worker + Beat)
# ---------------------------------------------------------------------
# This is the default. Dispatch to Redis; if the broker throws a connection
# error, the shared dispatcher falls back to inline/BackgroundTasks execution.
CELERY_TASK_ALWAYS_EAGER=false
USE_SYNC_TASKS_FALLBACK=true
TASK_EAGER_PROPAGATES=false
# Start: celery -A app.celery_app worker --loglevel=info --concurrency=2
#        celery -A app.celery_app beat --loglevel=info

# Short timeouts keep a dead broker from hanging an HTTP request.
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_CACHE_SOCKET_TIMEOUT=1.0

# ---- Rate Limiting (slowapi) ----
# Global default applied to every endpoint unless overridden below.
RATE_LIMIT_GLOBAL=100/minute
# AI endpoints (Copilot, Symptom Bot) — shared 10/minute default.
RATE_LIMIT_COPILOT=10/minute
# OCR upload (bills + prescriptions) — intentionally strict at 10/minute
# because each request triggers a paid Google Cloud Vision API call.
# Raise only if you have billing alerts set up and accept the cost.
RATE_LIMIT_OCR=10/minute
# Login endpoint — brute-force protection.
RATE_LIMIT_AUTH=5/minute
# Public registration / setup wizard endpoints.
RATE_LIMIT_SETUP=5/hour

# ---- PharmaCopilot (Pillar 2) ----
# Leave empty to use the deterministic fallback (no AI responses).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- WhatsApp Notifications (Priority 1) ----
# Leave all empty to disable WhatsApp delivery (in-app notifications still work).
# For Twilio sandbox testing: use whatsapp:+14155238886 as the number.
# For production: use your approved WhatsApp Business number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ---- Sentry Error Tracking (Priority 2e) ----
# Leave empty to disable. Get a DSN at sentry.io.
SENTRY_DSN=

# ---- Voice Assistant (Gemini API) ----
# Key comes from Google AI Studio (https://aistudio.google.com/apikey).
# It's free-tier with rate limits (not unlimited).
# The primary/fallback model split combines two separate free quotas for better resilience.
GEMINI_API_KEY=
